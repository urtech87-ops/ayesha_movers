{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"background": false,
			"text": false,
			"link": false,
			"heading": false,
			"button": false,
			"caption": false,
			"palette": [
				{ "slug": "box-yellow", "name": "Gold", "color": "#F2B705" },
				{ "slug": "cab-teal", "name": "Navy", "color": "#0C1239" },
				{ "slug": "tarmac", "name": "Slate (body text)", "color": "#4A5068" },
				{ "slug": "concrete", "name": "Light grey", "color": "#F4F5F8" },
				{ "slug": "paper", "name": "White", "color": "#FFFFFF" }
			]
		},
		"custom": {
			"color": {
				"chat-green": "#25D366",
				"chat-green-hover": "#3DDC77"
			},
			"header-height": "84px",
			"sticky-bar-height": "56px",
			"tap-target": "48px",
			"radius": "2px",
			"focus-width": "3px",
			"measure": "68ch"
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS (4px)", "size": "0.25rem" },
				{ "slug": "20", "name": "S (8px)", "size": "0.5rem" },
				{ "slug": "30", "name": "M (16px)", "size": "1rem" },
				{ "slug": "40", "name": "One line (26-28px)", "size": "clamp(1.625rem, 1.5732rem + 0.2210vw, 1.75rem)" },
				{ "slug": "50", "name": "Two lines (52-56px)", "size": "clamp(3.25rem, 3.1464rem + 0.4420vw, 3.5rem)" },
				{ "slug": "60", "name": "Section (52-104px)", "size": "clamp(3.25rem, 1.9033rem + 5.7459vw, 6.5rem)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Roboto",
					"fontFamily": "Roboto, \"Roboto Fallback\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Roboto", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/roboto-latin-400.woff2" ] },
						{ "fontFamily": "Roboto", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/roboto-latin-500.woff2" ] },
						{ "fontFamily": "Roboto", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/roboto-latin-700.woff2" ] }
					]
				},
				{
					"slug": "display",
					"name": "Roboto (headings)",
					"fontFamily": "Roboto, \"Roboto Fallback\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small (14-15px)", "size": "clamp(0.875rem, 0.8491rem + 0.1105vw, 0.9375rem)" },
				{ "slug": "base", "name": "Body (17px)", "size": "1.0625rem" },
				{ "slug": "lead", "name": "Lead (19px)", "size": "1.1875rem" },
				{ "slug": "heading-3", "name": "Heading 3 (20-24px)", "size": "clamp(1.25rem, 1.1464rem + 0.4420vw, 1.5rem)" },
				{ "slug": "heading-2", "name": "Heading 2 (26-34px)", "size": "clamp(1.625rem, 1.4178rem + 0.8840vw, 2.125rem)" },
				{ "slug": "heading-1", "name": "Heading 1 (34-52px)", "size": "clamp(2.125rem, 1.6588rem + 1.9890vw, 3.25rem)" },
				{ "slug": "home-h1", "name": "Home heading (32-56px)", "size": "clamp(2rem, 1.3785rem + 2.6519vw, 3.5rem)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--tarmac)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1rem, 0.7928rem + 0.8840vw, 1.5rem)",
				"right": "clamp(1rem, 0.7928rem + 0.8840vw, 1.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--cab-teal)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--cab-teal)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"fontWeight": "700",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-2)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "fontWeight": "500", "lineHeight": "1.3" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--lead)", "lineHeight": "1.25" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.3" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.3" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--cab-teal)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": { "radius": "var(--wp--custom--radius)", "width": "0" },
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "500",
					"lineHeight": "1.3",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "#1E2660",
						"text": "var(--wp--preset--color--paper)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--tarmac)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "lineHeight": "1.45" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1",
					"fontSize": "var(--wp--preset--font-size--lead)"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--base)" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/details": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)" }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-sections", "title": "Page with sections (heading in the page)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sticky-bar", "title": "Mobile Call and WhatsApp bar", "area": "uncategorized" }
	]
}
