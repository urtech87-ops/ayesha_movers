{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"background": false,
			"text": false,
			"link": false,
			"heading": false,
			"button": false,
			"caption": false,
			"palette": [
				{ "slug": "box-yellow", "name": "Box yellow", "color": "#F2B705" },
				{ "slug": "cab-teal", "name": "Cab teal", "color": "#0F4D4A" },
				{ "slug": "tarmac", "name": "Tarmac", "color": "#3F6F6B" },
				{ "slug": "concrete", "name": "Concrete", "color": "#E8EBE9" },
				{ "slug": "paper", "name": "Paper", "color": "#FFFFFF" }
			]
		},
		"custom": {
			"color": {
				"chat-green": "#25D366",
				"chat-green-hover": "#3DDC77"
			},
			"header-height": "64px",
			"sticky-bar-height": "56px",
			"tap-target": "48px",
			"radius": "4px",
			"focus-width": "3px",
			"measure": "68ch"
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS (4px)", "size": "0.25rem" },
				{ "slug": "20", "name": "S (8px)", "size": "0.5rem" },
				{ "slug": "30", "name": "M (16px)", "size": "1rem" },
				{ "slug": "40", "name": "One line (26-28px)", "size": "clamp(1.625rem, 1.5732rem + 0.2210vw, 1.75rem)" },
				{ "slug": "50", "name": "Two lines (52-56px)", "size": "clamp(3.25rem, 3.1464rem + 0.4420vw, 3.5rem)" },
				{ "slug": "60", "name": "Section (52-104px)", "size": "clamp(3.25rem, 1.9033rem + 5.7459vw, 6.5rem)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Archivo",
					"fontFamily": "Archivo, \"Archivo Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "400 800",
							"fontStretch": "62% 100%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-latin-var.woff2" ]
						}
					]
				},
				{
					"slug": "display",
					"name": "Archivo condensed (display)",
					"fontFamily": "Archivo, \"Archivo Display Fallback\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small (14-15px)", "size": "clamp(0.875rem, 0.8491rem + 0.1105vw, 0.9375rem)" },
				{ "slug": "base", "name": "Body (17-18px)", "size": "clamp(1.0625rem, 1.0366rem + 0.1105vw, 1.125rem)" },
				{ "slug": "lead", "name": "Lead (21-24px)", "size": "clamp(1.3125rem, 1.2348rem + 0.3315vw, 1.5rem)" },
				{ "slug": "heading-3", "name": "Heading 3 (27-32px)", "size": "clamp(1.6875rem, 1.5580rem + 0.5525vw, 2rem)" },
				{ "slug": "heading-2", "name": "Heading 2 (33-43px)", "size": "clamp(2.0625rem, 1.8035rem + 1.1050vw, 2.6875rem)" },
				{ "slug": "heading-1", "name": "Heading 1 (41-57px)", "size": "clamp(2.5625rem, 2.1481rem + 1.7680vw, 3.5625rem)" },
				{ "slug": "home-h1", "name": "Home heading (52-76px)", "size": "clamp(3.25rem, 2.6285rem + 2.6519vw, 4.75rem)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--cab-teal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1rem, 0.7928rem + 0.8840vw, 1.5rem)",
				"right": "clamp(1rem, 0.7928rem + 0.8840vw, 1.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"color": { "text": "currentColor" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"fontWeight": "800",
					"lineHeight": "0.95",
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-2)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-3)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--lead)", "lineHeight": "1.25" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.3" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.3" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--cab-teal)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": { "radius": "var(--wp--custom--radius)", "width": "0" },
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--tarmac)",
						"text": "var(--wp--preset--color--paper)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--tarmac)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "lineHeight": "1.45" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1",
					"fontSize": "var(--wp--preset--font-size--lead)"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--base)" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/details": {
				"typography": { "fontSize": "var(--wp--preset--font-size--base)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sticky-bar", "title": "Mobile Call and WhatsApp bar", "area": "uncategorized" }
	]
}
