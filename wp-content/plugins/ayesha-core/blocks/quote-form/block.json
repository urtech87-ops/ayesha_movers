{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ayesha/quote-form",
	"title": "Quote request form",
	"category": "widgets",
	"icon": "feedback",
	"description": "The detailed quote request form. Requests are saved under Enquiries and emailed to the Business Info address. Change the labels and the button text in the sidebar.",
	"keywords": [ "quote", "form", "enquiry", "contact" ],
	"textdomain": "ayesha-core",
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"customClassName": false
	},
	"attributes": {
		"legendYou": { "type": "string", "default": "About you" },
		"legendMove": { "type": "string", "default": "Your move" },
		"legendNeeds": { "type": "string", "default": "What you need" },
		"labelName": { "type": "string", "default": "Your name" },
		"labelPhone": { "type": "string", "default": "Phone or WhatsApp number" },
		"hintPhone": { "type": "string", "default": "Bahrain: 8 digits, e.g. 3xxx xxxx. Other countries: start with the country code, e.g. +966." },
		"labelEmail": { "type": "string", "default": "Email" },
		"hintEmail": { "type": "string", "default": "Optional. We send a copy of your request here." },
		"labelReply": { "type": "string", "default": "Best way to reply" },
		"labelMoveType": { "type": "string", "default": "Type of move" },
		"labelFrom": { "type": "string", "default": "Moving from" },
		"hintFrom": { "type": "string", "default": "Area or city, e.g. Juffair" },
		"labelTo": { "type": "string", "default": "Moving to" },
		"hintTo": { "type": "string", "default": "Area, city or country" },
		"labelDate": { "type": "string", "default": "Preferred date" },
		"labelFlexible": { "type": "string", "default": "My date is flexible" },
		"labelSize": { "type": "string", "default": "Property size" },
		"labelPickup": { "type": "string", "default": "At pickup" },
		"labelDropoff": { "type": "string", "default": "At drop-off" },
		"labelFloor": { "type": "string", "default": "Floor" },
		"labelLift": { "type": "string", "default": "Lift" },
		"labelServices": { "type": "string", "default": "Services you need" },
		"hintServices": { "type": "string", "default": "Tick all that apply." },
		"labelItems": { "type": "string", "default": "Big or special items" },
		"hintItems": { "type": "string", "default": "For example a piano, a large wardrobe, a glass table or a safe." },
		"labelTruck": { "type": "string", "default": "Truck hire" },
		"labelTruckTime": { "type": "string", "default": "For how long" },
		"submitText": { "type": "string", "default": "Send quote request" },
		"privacyNote": { "type": "string", "default": "We only use your details to reply about your move." },
		"successTitle": { "type": "string", "default": "Quote request sent" },
		"successText": { "type": "string", "default": "We will reply on WhatsApp or by phone. Want to send photos of your things? Send this on WhatsApp too, and add them in the chat." },
		"whatsappText": { "type": "string", "default": "Send this on WhatsApp too" }
	},
	"editorScript": "ayesha-quote-form-editor",
	"viewScript": "ayesha-quote-form-view",
	"style": "ayesha-quote-form"
}
